# =====================================================================
# OmniSight-OSINT Configuration Environment File (.env)
# =====================================================================
# Copy this file to .env and fill in your optional API keys.
# The tool operates fully on offline/free tiers when keys are omitted.

# Network & IP Geolocation (https://ipinfo.io/account/token)
IPINFO_API_KEY=

# Phone Carrier Intelligence (https://numverify.com/)
NUMVERIFY_API_KEY=

# Data Breach Intelligence (https://haveibeenpwned.com/API/v3)
HIBP_API_KEY=

# DeHashed / Leak-Lookup API Credentials
DEHASHED_API_KEY=
DEHASHED_EMAIL=
LEAKLOOKUP_API_KEY=

# Operational Parameters
REQUEST_TIMEOUT=10
MAX_CONCURRENT_REQUESTS=15
DEFAULT_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36 OmniSight-OSINT/1.0"
MOCK_BREACH_DATA=True
